{{- /* A local slice, not Scratch: Scratch persists across dev-server rebuilds and doubled the index. */ -}}
{{- $entries := slice -}}
{{- $pages := where site.RegularPages "Type" "not in" (slice "page" "json") -}}
{{- $pages := where $pages "Params.draft" "!=" true -}}
{{- range $index, $page := $pages -}}
  {{- $entries = $entries | append (dict 
    "id" $index
    "title" $page.Title
    "permalink" $page.Permalink
    "content" (plainify $page.Content | truncate 500)
    "summary" (plainify $page.Summary | truncate 200)
    "section" $page.Section
    "date" ($page.Date.Format "2006-01-02")
    "tags" (or $page.Params.tags slice)
  ) -}}
{{- end -}}
{{- $entries | jsonify -}}